rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSchematicId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLayoutOptions(opts) {
      return opts is map
        && opts.keys().hasOnly(['includeBeacons', 'includePowerPoles', 'directInsertion'])
        && (!('includeBeacons' in opts) || opts.includeBeacons is bool)
        && (!('includePowerPoles' in opts) || opts.includePowerPoles is bool)
        && (!('directInsertion' in opts) || opts.directInsertion is bool);
    }

    function isValidSchematic(data, userId, schematicId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'description',
          'packId',
          'rateUnit',
          'compactionMode',
          'targets',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'description',
          'packId',
          'rateUnit',
          'compactionMode',
          'targets',
          'defaultBeltId',
          'defaultInserterId',
          'rawResourceOverrides',
          'preferredRecipes',
          'stageOverrides',
          'researchProductivityBonuses',
          'layoutOptions',
          'blueprintString',
          'createdAt',
          'updatedAt'
        ])
        && data.id == schematicId
        && isValidSchematicId(data.id)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 300
        && data.packId is string
        && data.packId.size() >= 1
        && data.packId.size() <= 80
        && data.packId.matches('^[a-zA-Z0-9_.\\-]+$')
        && data.rateUnit in ['per_second', 'per_minute', 'per_hour']
        && data.compactionMode in ['compact', 'standard']
        && data.targets is list
        && data.targets.size() >= 1
        && data.targets.size() <= 12
        && data.targets[0] is map
        && data.targets[0].keys().hasAll(['itemId', 'ratePerSec'])
        && data.targets[0].keys().hasOnly(['itemId', 'ratePerSec'])
        && data.targets[0].itemId is string
        && data.targets[0].itemId.size() >= 1
        && data.targets[0].itemId.size() <= 80
        && data.targets[0].ratePerSec is number
        && data.targets[0].ratePerSec > 0
        && (!('defaultBeltId' in data) || (data.defaultBeltId is string && data.defaultBeltId.size() >= 1 && data.defaultBeltId.size() <= 80))
        && (!('defaultInserterId' in data) || (data.defaultInserterId is string && data.defaultInserterId.size() >= 1 && data.defaultInserterId.size() <= 80))
        && (!('rawResourceOverrides' in data) || (
          data.rawResourceOverrides is list
          && data.rawResourceOverrides.size() <= 40
          && (data.rawResourceOverrides.size() == 0 || (data.rawResourceOverrides[0] is string && data.rawResourceOverrides[0].size() >= 1 && data.rawResourceOverrides[0].size() <= 80))
        ))
        && (!('preferredRecipes' in data) || (data.preferredRecipes is map && data.preferredRecipes.size() <= 80))
        && (!('stageOverrides' in data) || (data.stageOverrides is map && data.stageOverrides.size() <= 80))
        && (!('researchProductivityBonuses' in data) || (data.researchProductivityBonuses is map && data.researchProductivityBonuses.size() <= 40))
        && (!('layoutOptions' in data) || isValidLayoutOptions(data.layoutOptions))
        && (!('blueprintString' in data) || (data.blueprintString is string && data.blueprintString.size() <= 32000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /schematics/{schematicId} {
        allow get: if isValidId(userId)
          && isValidSchematicId(schematicId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidSchematicId(schematicId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidSchematic(incoming(), userId, schematicId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidSchematicId(schematicId)
          && isVerifiedUser()
          && isOwner(userId)
          && isValidSchematic(incoming(), userId, schematicId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'description',
            'packId',
            'rateUnit',
            'compactionMode',
            'targets',
            'defaultBeltId',
            'defaultInserterId',
            'rawResourceOverrides',
            'preferredRecipes',
            'stageOverrides',
            'researchProductivityBonuses',
            'layoutOptions',
            'blueprintString',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId)
          && isValidSchematicId(schematicId)
          && isVerifiedUser()
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }
  }
}
